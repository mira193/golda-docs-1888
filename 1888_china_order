  document.getElementById("edit-track").value = o.track || "";
  document.getElementById("edit-link").value = o.link || "";
  document.getElementById("edit-img").value = o.img || "";
  document.getElementById("edit-qty").value = o.qty || 1;
  document.getElementById("edit-price-cny").value = o.priceCny || "";
  document.getElementById("edit-rate-cny").value = o.rateCny || 5.80;
