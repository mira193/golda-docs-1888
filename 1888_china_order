// ══════════════════════ ІМПОРТ НАКЛАДНОЇ КАРГО ══════════════════════
function handleInvoiceUpload(event) {
  const file = event.target.files[0];
  if (!file) return;

  const today = getTodayRates();
  const reader = new FileReader();
  reader.onload = function(e) {
    try {
      const data = new Uint8Array(e.target.result);
      const workbook = XLSX.read(data, {type: 'array'});
      const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
      const rows = XLSX.utils.sheet_to_json(firstSheet, {header: 1, defval: ''});

      let trackColIdx = -1, costColIdx = -1, headerRowIdx = -1;

      for (let r = 0; r < Math.min(25, rows.length); r++) {
        for (let c = 0; c < rows[r].length; c++) {
          const val = String(rows[r][c]).toLowerCase();
          if (val.includes('трек')) trackColIdx = c;
          if (val.includes('вартість') || val.includes('стоимость') || val.includes('сумма') || val.includes('ціна')) costColIdx = c;
        }
        if (trackColIdx !== -1 && costColIdx !== -1) {
          headerRowIdx = r;
          break;
        }
      }

      if (trackColIdx === -1) trackColIdx = 2;
      if (costColIdx === -1) costColIdx = 8;
      if (headerRowIdx === -1) headerRowIdx = 10;

      let matchedCount = 0;
      const invoiceData = {};

      for (let r = headerRowIdx + 1; r < rows.length; r++) {
        const row = rows[r];
        if (!row || !row[trackColIdx]) continue;
        const rawTrack = String(row[trackColIdx]).trim().replace(/\s+/g, '');
        const cost = parseFloat(String(row[costColIdx]).replace(',', '.')) || 0;
        if (rawTrack && cost > 0) invoiceData[rawTrack] = cost;
      }

      orders.forEach(order => {
        if (!order.track) return;
        const cleanTrack = String(order.track).trim().replace(/\s+/g, '');
        if (invoiceData[cleanTrack] !== undefined) {
          order.shippingVal = invoiceData[cleanTrack];
          order.shippingCur = 'USD';
          order.rateUsd = today.usd;
          order.isAutoShip = true;
          if (order.status === 'ordered' || order.status === 'wh-cn') order.status = 'transit';
          matchedCount++;
        }
      });

      cloudSave();
      alert(`✓ Успішно!\nЗнайдено треків: ${Object.keys(invoiceData).length}\nОновлено доставку для: ${matchedCount} замовлень.`);
    } catch(err) {
      alert('Помилка: ' + err.message);
    }
  };
  reader.readAsArrayBuffer(file);
  event.target.value = '';
}

// ══════════════════════ ВІДОБРАЖЕННЯ ТАБЛИЦІ ══════════════════════
function renderTable() {
  const tbody = document.getElementById("orders-body");
  const q = (document.getElementById("search-input")?.value || "").toLowerCase().trim();

  let filtered = orders.filter(o => {
    if (currentFilter === "active" && o.isArchived) return false;
    if (currentFilter === "archived" && !o.isArchived) return false;
    if (["ordered", "wh-cn", "transit", "received"].includes(currentFilter)) {
      if (o.isArchived || o.status !== currentFilter) return false;
    }
    if (q) {
      const matchName = (o.name || "").toLowerCase().includes(q);
      const matchTrack = (o.track || "").toLowerCase().includes(q);
      if (!matchName && !matchTrack) return false;
    }
    return true;
  });

  if (!filtered.length) {
    tbody.innerHTML = '<tr><td colspan="11" style="text-align:center;padding:25px;color:#aaa">Немає відповідних замовлень.</td></tr>';
    return;
  }

  const statusMap = {
    'ordered': '<span class="badge st-ordered">🟡 Замовлено</span>',
    'wh-cn': '<span class="badge st-wh-cn">🟠 Склад CN</span>',
    'transit': '<span class="badge st-transit">🔵 В дорозі</span>',
    'received': '<span class="badge st-received">🟢 Отримано</span>'
  };

  tbody.innerHTML = filtered.map(o => {
    const unitCost = calcUnitCost(o);
    const markup = o.markup || 50;
    const sellPrice = unitCost * (1 + markup / 100);
    const unitProfit = sellPrice - unitCost;

    const imgHtml = o.img 
      ? `<img src="${o.img}" class="prod-img" onclick="viewImage('${o.img}')" title="Клікніть, щоб збільшити">`
      : `<div class="prod-img">📷</div>`;

    const trackHtml = o.track 
      ? `<a href="https://t.17track.net/en#nums=${encodeURIComponent(o.track)}" target="_blank" class="track-link" title="Відстежити на 17TRACK">${o.track} ↗</a>`
      : `<span style="color:#bbb">—</span>`;

    const linkHtml = o.link 
      ? `<div style="margin-top:2px"><a href="${o.link}" target="_blank" class="ext-link">🔗 Посилання на товар</a></div>` 
      : '';

    const autoBadge = o.isAutoShip ? `<span class="badge-auto" title="З накладної карго">✓ карго</span>` : '';

    return `
      <tr class="${o.isArchived ? 'archived-row' : ''}">
        <td style="text-align:center">${imgHtml}</td>
        <td>
          <b>${o.name}</b>
          ${linkHtml}
        </td>
        <td>${trackHtml}</td>
        <td style="text-align:center"><b>${o.qty}</b></td>
        <td>
          <div>${Number(o.priceCny || 0).toFixed(2)} ¥</div>
          <div class="calc-sub">курс: <b>${(o.rateCny || 5.80).toFixed(2)}</b></div>
        </td>
        <td>
          <div>
            <b>${o.shippingVal ? `${o.shippingVal} ${o.shippingCur === 'USD' ? '$' : o.shippingCur === 'CNY' ? '¥' : 'грн'}` : '0.00'}</b>
            ${autoBadge}
          </div>
          <div class="calc-sub">≈ ${shipToUah(o).toFixed(2)} грн</div>
        </td>
        <td>
          <div class="calc-res">${unitCost.toFixed(2)} грн</div>
        </td>
        <td>
          <div class="price-tag">${sellPrice.toFixed(2)} грн</div>
          <div class="profit-tag">+${markup}% (маржа: ${unitProfit.toFixed(1)} грн)</div>
        </td>
        <td>${statusMap[o.status] || o.status}</td>
        <td style="font-size:11px;white-space:nowrap">${o.eta || '—'}</td>
        <td style="text-align:center;white-space:nowrap">
          <button class="btn-icon" onclick="openEditModal(${o.id})" title="Редагувати">✏️</button>
          <button class="btn-icon" onclick="toggleArchive(${o.id})" title="${o.isArchived ? 'Повернути з архіву' : 'Перемістити в архів'}">${o.isArchived ? '📂' : '🗄️'}</button>
          <button class="btn-icon" onclick="deleteOrder(${o.id})" title="Видалити" style="color:#e74c3c">🗑</button>
        </td>
      </tr>
    `;
  }).join('');
}

